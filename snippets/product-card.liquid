<div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow border border-slate-100 overflow-hidden flex flex-col h-full group">

    <!-- Product Image -->
    <a href="{{ product.url }}" class="block relative aspect-w-1 aspect-h-1 bg-slate-50 overflow-hidden">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | img_url: '500x500', crop: 'center' }}" alt="{{ product.title | escape }}" class="w-full object-cover group-hover:scale-105 transition-transform duration-300" />
        {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'w-full h-64 object-cover bg-slate-200 group-hover:scale-105 transition-transform duration-300' }}
        {% endif %}
    </a>

    <!-- Product Details -->
    <div class="p-5 flex flex-col flex-grow">
        <h3 class="text-lg font-bold text-slate-900 mb-2 leading-tight">
            <a href="{{ product.url }}" class="hover:text-blue-600 transition-colors">
                {{ product.title }}
            </a>
        </h3>

        <!-- Push price to bottomif title is short -->
        <p class="text-slate-600 font-semibold mt-auto">
            {{ product.price | money }}
        </p>
    </div>
</div>