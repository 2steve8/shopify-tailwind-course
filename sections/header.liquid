<header class="bg-slate-900 py-4 shadow-md relative">
  <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">

    <!-- Store Name -->
    <a href="{{ routes.root_url }}" class="text-2xl font-bold text-blue-400 tracking-tight">
      {{ shop.name }}
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex space-x-8">
      {% for link in linklists[section.settings.menu].links %}

        {% if link.links != blank %}
          <div class="relative group py-2">
            <button class="flex items-center gap-1 text-gray-200 hover:text-blue-400 font-medium transition-colors">
              {{ link.title }}
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute left-0 top-full w-48 bg-white border border-gray-200 shadow-xl rounded-md hidden group-hover:flex flex-col py-2 z-50">
              {% for childlink in link.links %}
                <a href="{{ childlink.url }}" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 hover:text-blue-600 transition-colors">
                  {{ childlink.title }}
                </a>
              {% endfor %}
            </div>
          </div>
        {% else %}
          <a href="{{ link.url }}" class="text-gray-200 hover:text-blue-400 font-medium transition-colors py-2">
            {{ link.title }}
          </a>
        {% endif %}

      {% endfor %}
    </nav>

    <!-- Right Side Icons: Cart, Account, and Mobile Toggle -->
    <div class="flex items-center space-x-5 text-gray-200">

      <!-- Cart Icon -->
      <a href="{{ routes.cart_url }}" class="hover:text-blue-400 transitions colors flex item-scenter">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
      </a>

      <!-- Account Icon (Conditional) -->
      {% if shop.customer_accounts_enabled %}
        {% if customer %}
          <!-- Logged In -->
          <a href="{{ routes.account_url }}" class="hover:text-blue-400 transition-colors hidden md:block">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </a>
        {% else %}
          <!-- Logged Out -->
          <a href="{{ routes.account_login_url }}" class="hover:text-blue-400 transition-colors hidden md:block">
            <span class="text-sm font-medium">Log in</span>
          </a>
        {% endif %}
      {% endif %}

      <!-- Mobile Menu Button (Hamburger) -->
      <button id="mobile-menu-button" type="button" class="md:hidden hover:text-blue-400 focus:outline-none transition-colors">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Menu Panel -->
  <div id="mobile-menu-panel" class="hidden md:hidden absolute top-full left-0 w-full bg-slate-800 shadow-lg z-50">
    <div class="px-4 pt-2 pb-4 space-y-1">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}" class="block px-3 py-2 text-base font-medium text-gray-200 hover:text-blue-400 hover:bg-slate-700 rounded.md transition-colors">
          {{ link.title }}
        </a>
      {% endfor %}

      <!-- Mobile Account Links -->
      {% if shop.customer_accounts_enabled %}
        <div class="border-t border-slate-700 mt-2 pt-2">
          {% if customer %}
            <a href="{{ routes.account_url }}" class="block px-3 py-2 text-base font-medium text-gray-200 hover:text-blue-400 hover:bg-slate-700 rounded-md transition-colors">Account</a>
          {% else %}
            <a href="{{ routes.account_login_url }}" class="block px-3 py-2 text-base font-medium text-gray-200 hover:text-blue-400 hover:bg-slate-700 rounded-md transition-colors">Log in</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</header>

<script>
  document.getElementById('mobile-menu-button').addEventListener('click', function () {
    var panel = document.getElementById('mobile-menu-panel')
    panel.classList.toggle('hidden')
  })
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Header Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}