<footer class="bg-slate-900 text-gray-300 py-12 mt-20 border-t border-slate-900">
  <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-12">

    <!-- Column 1: Store Information -->
    <div>
      <h3 class="text-xl font-bold text-white mb-4">{{ shop.name }}</h3>
      <p class="text-sm text-gray-400 leading-relaxed">
        {{ section.settings.store_decription }}
      </p>
    </div>

    <!-- Column 2: Quick Links -->
    <div>
      <h3 class="text-lg font-bold text-white mb-4">Quick Links</h3>
      <ul class="space-y-3">
        {% for link in linklists[section.settings.footer_menu].links %}
          <a href="{{ link.url }}" class="hover:text-blue-400 transition-colors text-sm">{{ link.title }}</a>
        {% endfor %}
      </ul>
    </div>

    <!-- Column 3: Copyright & Legal -->
    <div>
      <h3 class="text-lg font-bold text-white mb-4">Legal</h3>
      <p class="text-sm text-gray-400 mb-4">
        &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved
      </p>
      <!-- The standard "Powered by Shopify link" -->
      <div class="text-xs text-slate-600 hover:text-slate-400 transition-colors">
        {{ powered_by_link }}
      </div>
    </div>

  </div>
</footer>

{% schema %}
  {
    "name": "Footer",
    "settings": [
      {
        "type": "textarea",
        "id": "store_description",
        "label": "Store Description",
        "default": "Providing high-quality gear for your next adventure. Based in San Mateo, shipping worldwide"
      },
      {
        "type": "link_list",
        "id": "footer_menu",
        "label": "Footer Menu",
        "default": "footer"
      }
    ]
  }
{% endschema %}