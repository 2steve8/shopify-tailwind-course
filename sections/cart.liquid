<div class="max-w-7xl mx-auto px-4 py-12">
  
  <h1 class="text-4xl font-extrabold text-slate-900 mb-8">{{ section.settings.title }}</h1>

  {% if cart.empty? %}
    
    <!-- Empty Cart State -->
    <div class="text-center py-16 bg-slate-50 rounded-xl border border-slate-200">
      <h2 class="text-2xl font-bold text-slate-700 mb-4">Your cart is currently empty.</h2>
      <a href="{{ routes.all_products_collection_url }}" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium px-6 py-3 rounded-md transition-colors">
        Continue Shopping
      </a>
    </div>

  {% else %}
    
    <!-- Filled Cart Form -->
    <form action="{{ routes.cart_url }}" method="post" novalidate class="flex flex-col lg:flex-row gap-12">
      
      <!-- Cart Items Table -->
      <div class="flex-1 w-full">
        <table class="table-auto w-full text-left">
          <thead class="border-b border-slate-200">
            <tr>
              <th class="pb-4 font-semibold text-slate-600">Product</th>
              <th class="pb-4 font-semibold text-slate-600">Quantity</th>
              <th class="pb-4 font-semibold text-slate-600 text-right">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {% for item in cart.items %}
              <tr class="group">
                <td class="py-6 flex items-center gap-4">
                  {% if item.image %}
                    <img src="{{ item.image | img_url: '200x' }}" alt="{{ item.title | escape }}" class="w-20 h-20 object-cover rounded-md shadow-sm" />
                  {% endif %}
                  <div>
                    <a href="{{ item.url }}" class="text-lg font-bold text-slate-900 hover:text-blue-600 transition-colors">{{ item.product.title }}</a>
                    <p class="text-sm text-gray-500">{{ item.variant.title }}</p>
                    <a href="{{ item.url_to_remove }}" class="text-red-500 text-sm font-medium hover:underline mt-1 inline-block">Remove</a>
                  </div>
                </td>
                
                <td class="py-6">
                  <!-- Quantity Input -->
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="w-20 border border-slate-300 rounded-md px-3 py-2 text-center focus:outline-none focus:ring-2 focus:ring-blue-500">
                </td>
                
                <td class="py-6 text-right font-semibold text-slate-900">
                  {{ item.final_line_price | money }}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <!-- Order Summary Sidebar -->
      <div class="w-full lg:w-96 bg-slate-50 p-8 rounded-xl border border-slate-200 h-fit">
        <h2 class="text-xl font-bold text-slate-900 mb-6">Order Summary</h2>
        
        <div class="flex justify-between items-center mb-6 pb-6 border-b border-slate-200">
          <span class="text-slate-600 font-medium">Subtotal</span>
          <span class="text-2xl font-bold text-slate-900">{{ cart.total_price | money }}</span>
        </div>
        
        <p class="text-sm text-gray-500 mb-6">Taxes and shipping calculated at checkout.</p>
        
        <div class="space-y-4">
          <!-- Update Button (Triggers the form post to update quantities) -->
          <button type="submit" name="update" class="w-full bg-white border-2 border-slate-900 text-slate-900 hover:bg-slate-900 hover:text-white font-medium px-6 py-3 rounded-md transition-colors">
            Update Cart
          </button>
          
          <!-- Checkout Button (Sends user to Shopify Checkout) -->
          <button type="submit" name="checkout" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium px-6 py-3 rounded-md transition-colors">
            Proceed to Checkout
          </button>
        </div>
      </div>

    </form>
  {% endif %}

</div>

{% schema %}
{
  "name": "Cart Page",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Your Cart"
    }
  ]
}
{% endschema %}