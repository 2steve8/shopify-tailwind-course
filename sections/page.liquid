<div class="max-w-4xl mx-auto py-16">

  <h1 class="text-xl md:text-5xl font-extrabold text-slate-900 mb-8 text-center">
    {{ page.title }}
  </h1>

  <!-- page.content outputs the raw HTML generated by Shopify's editor -->
  <div class="text-slate-900 text-lg leading-relaxed space-y-6">
    {{ page.content }}
  </div>

</div>

{% schema %}
  {
    "name": "Page",
    "settings": []
  }
{% endschema %}