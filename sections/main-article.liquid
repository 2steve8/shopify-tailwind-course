<article class="max-w-4xl mx-auto px-4 py-12">
  {% for block in section.blocks %}
    {% case block.type %}
    
      {% when 'title' %}
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-4" {{ block.shopify_attributes }}>
          {{ article.title }}
        </h1>

      {% when 'author' %}
        <p class="text-lg text-gray-600 font-medium mb-1" {{ block.shopify_attributes }}>
          Written by {{ article.author }}
        </p>

      {% when 'date' %}
        <time class="text-sm text-gray-400 mb-8 block" datetime="{{ article.published_at | date: '%Y-%m-%d' }}" {{ block.shopify_attributes }}>
          {{ article.published_at | date: format: 'date'}}
        </time>

      {% when 'featured_image' %}
        {% if article.image %}
          <div class="mb-8" {{ block.shopify_attributes }}>
            <img src="{{ article.image | img_url: '1024x' }}" alt="{{ article.image | escape }}" class="w-full h-auto rounded-xl shadow-md" />
          </div>
        {% endif %}

      {% when 'content' %}
        <!-- Article content is raw HTML generated by the Shopify Admin rich text editor -->
        <div class="text-slate-800 text-lg leading-relaxed space-y-6" {{ block.shopify_attributes }}>
          {{ article.content }}
        </div>
    {% endcase %}
  {% endfor %}

</article>

{% schema %}
{
  "name": "article",
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "author",
      "name": "Author",
      "limit": 1
    },
    {
      "type": "date",
      "name": "Date",
      "limit": 1
    },
    {
      "type": "featured_image",
      "name": "Featured Image",
      "limit": 1
    },
    {
      "type": "content",
      "name": "Content",
      "limit": 1
    },
  ]
}
{% endschema %}