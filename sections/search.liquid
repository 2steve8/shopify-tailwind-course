{% paginate search.results by 12 %}
  <div class="max-w-7xl mx-auto px-4 py-12">

    <!-- Header & Search Form -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h1 class="text-4xl font-extrabold text-slate-900 mb-8">Search Results</h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="flex gap-2 max-w-xl mx-auto">
        <!-- Optional: Retrict search results to products only by uncommenting the line below -->
        <!-- <input type="hidden" name="type" value="product" /> -->

        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search our store..." class="flex-grow border border-slate-300 rounded-md px-4 py-3 focus:outline-none focus:right-2 focus:ring-blue-500 text-slate-900" />
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-6 py-3 rounded-md transition-colors shadow-sm">
          Search
        </button>
      </form>
    </div>

    <!-- Search Results -->
    {% if search.performed %}
      {% if search.results_count > 0 %}
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {% for item in search.results %}
            
            {% if item.object_type == 'product' %}
              <!-- Reuse our Product Card snippet -->
              {% render 'product-card', product: item %}
            {% else %}
              <!-- Fallback card for Pages and Articles -->
              <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 flex flex-col justify-center h-full hover:shadow-md transition-shadow">
                <p class="text-xs text-slate-500 uppercase tracking-wider mb-2">{{ item.object_type }}</p>
                <h3 class="text-lg font-bold text-slate-900 mb-4">
                  <a href="{{ item.url }}" class="hover:text-blue-600 transition-colors">{{ item.title }}</a>
                </h3>
                <a href="{{ item.url }}" class="text-blue-600 font-medium hover:underline mt-auto inline-flex items-center">
                  View {{ item.object_type }} &rarr;
                </a>
              </div>
            {% endif %}

          {% endfor %}
        </div>

        <!-- Pagination -->
        {% if paginate.pages > 1 %}
          <div class="flex justify-center mt-16 space-x-4">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" class="px-5 py-2 bg-white border border-slate-300 hover:border-slate-900 hover:text-blue-600 rounded-md transition-colors">&larr; Previous</a>
            {% endif %}

            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" class="px-5 py-2 bg-white border border-slate-300 hover:border-slate-900 hover:text-blue-600 rounded-md transition-colors">Next &rarr;</a>
            {% endif %}
          </div>
        {% endif %}

        {% else %}
          <!-- No Results State -->
          <p class="text-center text-gray-500 text-lg py-12">
            No results fournd for "<span class="font-semibold text-slate-900">{{ search.terms | escape }}</span>". Try checking your spelling or using different keywords.
          </p>
      {% endif %}
    {% endif %}

  </div>
{% endpaginate %}

{% schema %}
  {
    "name": "Search Page",
    "settings": []
  }
{% endschema %}