{% paginate blog.articles by section.settings.posts_per_page %}
  <div class="max-w-7xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-extrabold text-slate-900 text-center mb-12">
      {{ blog.title }}
    </h1>

    <!-- Article Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-8 gap-3">
      {% for article in blog.articles %}
        <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow border border-slate-100">

          {% if article.image %}
            <a href="{{ article.url }}">
              <img src="{{ article.image | img_url: '600x400', crop: 'center' }}" alt="{{ article.image.alt | escape }}" class="w-full h-48 object-cover" />
            </a>
          {% endif %}

          <div class="p-6">
            <time class="text-sm text-gray-400 mb-2 block" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
              {{ article.published_at | date: format: 'date'}}
            </time>
            <h2 class="text-xl font-bold text-slate-900 mb-2 leading-tight">
              <a href="{{ article.url }}" class="hover:text-blue-600 transition-colors ">
                {{ article.title }}
              </a>
            </h2>
            <p class="text-gray-600 mb-4 line-clamp-3">
              {% if article.excerpt.size > 0 %}
                {{ article.excerpt }}
              {% else %}
                {{ article.content | strip_html | truncatewords: 20 }}
              {% endif %}
            </p>
            <a href="{{ article.url }}" class="text-blue-600 font-medium hover:underline">Read more &rarr;</a>
          </div>

        </div>
      {% else %}
        <p class="text-center col-span-full text-gray-500 text-lg">No articles found in this blog.</p>
      {% endfor %}
    </div>

    <!-- Pagination -->
    {% if paginate.pages %}
      <div class="flex justify-center mt-12 space-x-4">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 rounded-md text-slate-800 font-medium transition-colors">&larr; Previous</a>
        {% endif %}

        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 rounded-md text-slate-800 font-medium transition-colors">Next &rarr;</a>
        {% endif %}
      </div>
    {% endif %}

  </div>
{% endpaginate %}

{% schema %}
{
  "name": "Blog Feed",
  "settings": [
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6,
      "label": "Posts per page"
    }
  ]
}
{% endschema %}